// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SALESMAN
  TELECALLER
  WAREHOUSE
  ADMIN
}

enum TaskRecurrence {
  WEEKLY
  MONTHLY
  ONCE
}

enum AttendanceStatus {
  LEAVE
  HALF_LEAVE
  ABSENT
  HOLIDAY_WEEKOFF
  OFFICE_DAY
  ON_ROUTE
}

enum NoOrderReason {
  STORE_CLOSED
  NO_STOCK_NEEDED
  OWNER_NOT_AVAILABLE
  PAYMENT_DISPUTE
  COMPETITOR_STOCKED
  OTHER
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  routeAssignments RouteAssignment[]
  visits           Visit[]
  attendances      Attendance[]
  telecallerLogs   TelecallerLog[]
  stockCounts      StockCount[]
  targets          Target[]
  importBatches    ImportBatch[]

  @@index([role])
}

model Route {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  stores      Store[]
  assignments RouteAssignment[]
  visits      Visit[]
  routeStores RouteStore[]
  attendances Attendance[]
}

model RouteAssignment {
  id      String @id @default(cuid())
  userId  String
  routeId String
  user    User   @relation(fields: [userId], references: [id])
  route   Route  @relation(fields: [routeId], references: [id])

  @@unique([userId, routeId])
}

model Store {
  id           String   @id @default(cuid())
  externalCode String?  @unique
  name         String
  address      String
  phone        String?
  // Primary route, set by store-master import. A store can additionally be
  // assigned to other routes via RouteStore (e.g. two salesmen covering
  // different product lines both visit the same medical store).
  routeId      String?
  route        Route?   @relation(fields: [routeId], references: [id])
  visitSequence Int?
  // Set from the GPS captured on the first confirmed visit, so any salesman
  // covering this route later can see the store has already been located.
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())

  visits           Visit[]
  telecallerLogs   TelecallerLog[]
  ledgerEntries    LedgerEntry[]
  purchaseHistory  PurchaseHistoryItem[]
  routeStores      RouteStore[]
  telecallerParty  TelecallerParty?

  @@index([routeId])
  @@index([name])
}

model RouteStore {
  id            String   @id @default(cuid())
  routeId       String
  storeId       String
  visitSequence Int?
  createdAt     DateTime @default(now())

  route Route @relation(fields: [routeId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([routeId, storeId])
  @@index([routeId])
  @@index([storeId])
}

model Visit {
  id               String         @id @default(cuid())
  userId           String
  storeId          String
  routeId          String?
  visitDate        DateTime       @default(now())
  latitude         Float
  longitude        Float
  photoUrl         String
  collectionAmount Decimal?
  orderAmount      Decimal?
  hasOrder         Boolean        @default(false)
  hasDiscount      Boolean        @default(false)
  noOrderReason    NoOrderReason?
  notes            String?
  createdAt        DateTime       @default(now())

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])
  route Route? @relation(fields: [routeId], references: [id])

  @@index([userId, visitDate])
  @@index([storeId])
  @@index([routeId])
}

model Attendance {
  id        String           @id @default(cuid())
  userId    String
  date      DateTime
  status    AttendanceStatus
  note      String?
  // Set when status=ON_ROUTE — which of the salesman's assigned routes
  // they're declaring themselves out on today.
  routeId   String?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id])
  route Route? @relation(fields: [routeId], references: [id])

  @@unique([userId, date])
  @@index([date])
}

model TelecallerLog {
  id               String         @id @default(cuid())
  userId           String
  storeId          String
  contactDate      DateTime       @default(now())
  orderAmount      Decimal?
  // Free text (e.g. "promised 3000 on next visit") — shown to the salesman
  // as a note next time they visit this store.
  paymentPromise   String?
  collectionAmount Decimal?
  hasOrder         Boolean        @default(false)
  noOrderReason    NoOrderReason?
  noPaymentReason  String?
  complaintNotes   String?
  createdAt        DateTime       @default(now())

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([userId, contactDate])
  @@index([storeId])
}

// Admin-defined recurring task (e.g. "sweep loading bay" every Monday, or
// "count fast-movers" on the 1st of the month). Not assigned to a specific
// person — any warehouse staff on shift can complete it.
model WarehouseTask {
  id          String         @id @default(cuid())
  title       String
  description String?
  recurrence  TaskRecurrence
  dayOfWeek   Int? // 0=Sunday..6=Saturday, used when recurrence=WEEKLY
  dayOfMonth  Int? // 1-31, used when recurrence=MONTHLY
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())

  occurrences WarehouseTaskOccurrence[]
}

// One row per time a task actually comes due. scheduledDate starts equal to
// originalDate but rolls forward a day at a time — automatically, whenever
// the warehouse dashboard is loaded — for as long as it stays incomplete or
// the day it was due had no one marked present.
model WarehouseTaskOccurrence {
  id            String    @id @default(cuid())
  taskId        String
  originalDate  DateTime
  scheduledDate DateTime
  completed     Boolean   @default(false)
  completedAt   DateTime?
  completedById String?

  task WarehouseTask @relation(fields: [taskId], references: [id])

  @@unique([taskId, originalDate])
  @@index([scheduledDate])
}

// The shelf-stock sheet: one physical count per item per day, regardless of
// which warehouse staff member recorded it.
model StockItem {
  id        String   @id @default(cuid())
  name      String   @unique
  company   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  counts StockCount[]

  @@index([company])
}

model StockCount {
  id            String   @id @default(cuid())
  stockItemId   String
  date          DateTime
  quantity      Decimal
  recordedById  String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  stockItem  StockItem @relation(fields: [stockItemId], references: [id])
  recordedBy User      @relation(fields: [recordedById], references: [id])

  @@unique([stockItemId, date])
  @@index([date])
}

model LedgerEntry {
  id                String    @id @default(cuid())
  storeId           String
  invoiceNo         String?
  invoiceDate       DateTime?
  amount            Decimal
  outstandingAmount Decimal
  dueDate           DateTime?
  uploadBatchId     String
  importedAt        DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([uploadBatchId])
}

model PurchaseHistoryItem {
  id            String    @id @default(cuid())
  storeId       String
  itemName      String
  quantity      Decimal
  unit          String?
  // Total sale value for this item over the report period — used to rank
  // "regularly bought items" highest-value-first for telecaller upsell asks.
  totalValue    Decimal?
  periodStart   DateTime?
  periodEnd     DateTime?
  uploadBatchId String
  importedAt    DateTime  @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([itemName])
}

// Admin-updated incentive scheme: item + incentive amount, shown to
// salesmen as "current incentives" on their dashboard. Each upload
// replaces the whole list, same as ExpiryItem.
model IncentiveItem {
  id              String    @id @default(cuid())
  itemName        String
  incentiveAmount Decimal
  uploadBatchId   String
  importedAt      DateTime  @default(now())
}

model ExpiryItem {
  id            String    @id @default(cuid())
  itemName      String
  expiryDate    DateTime
  specialRate   Decimal?
  uploadBatchId String
  importedAt    DateTime  @default(now())

  @@index([expiryDate])
}

model Target {
  id                String   @id @default(cuid())
  userId            String
  periodMonth       Int
  periodYear        Int
  monthlyTarget     Decimal
  todayTarget       Decimal
  perRetailerTarget Decimal
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, periodMonth, periodYear])
}

// Admin-uploaded call list ("party list"). If empty, the telecaller
// dashboard falls back to showing every store, so nothing breaks before
// the first upload.
model TelecallerParty {
  id            String   @id @default(cuid())
  storeId       String
  uploadBatchId String
  importedAt    DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId])
}

model ImportBatch {
  id           String   @id @default(cuid())
  importType   String
  fileName     String
  rowCount     Int
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy User @relation(fields: [uploadedById], references: [id])
}
