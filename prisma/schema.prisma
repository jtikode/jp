// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SALESMAN
  TELECALLER
  WAREHOUSE
  ADMIN
}

enum TaskRecurrence {
  WEEKLY
  MONTHLY
  ONCE
}

enum AttendanceStatus {
  LEAVE
  HALF_LEAVE
  ABSENT
  HOLIDAY_WEEKOFF
  OFFICE_DAY
  ON_ROUTE
}

enum NoOrderReason {
  STORE_CLOSED
  NO_STOCK_NEEDED
  OWNER_NOT_AVAILABLE
  PAYMENT_DISPUTE
  COMPETITOR_STOCKED
  OTHER
}

// One row per business using the app. Every other model is scoped to one of
// these via orgId, so no query ever needs to reason about more than one
// business's data at a time. `slug` is the "Business Code" typed at login
// and signup — there is no subdomain/custom-domain routing.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  users            User[]
  routes           Route[]
  routeAssignments RouteAssignment[]
  stores           Store[]
  routeStores      RouteStore[]
  visits           Visit[]
  attendances      Attendance[]
  telecallerLogs   TelecallerLog[]
  warehouseTasks   WarehouseTask[]
  warehouseTaskOccurrences WarehouseTaskOccurrence[]
  stockItems       StockItem[]
  stockCounts      StockCount[]
  ledgerEntries    LedgerEntry[]
  purchaseHistory  PurchaseHistoryItem[]
  incentiveItems   IncentiveItem[]
  expiryItems      ExpiryItem[]
  targets          Target[]
  telecallerParties TelecallerParty[]
  importBatches    ImportBatch[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  username     String
  passwordHash String
  name         String
  role         Role
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  org              Organization      @relation(fields: [orgId], references: [id])
  routeAssignments RouteAssignment[]
  visits           Visit[]
  attendances      Attendance[]
  telecallerLogs   TelecallerLog[]
  stockCounts      StockCount[]
  targets          Target[]
  importBatches    ImportBatch[]
  workingWithAttendances Attendance[] @relation("AttendanceWorkingWith")

  @@unique([orgId, username])
  @@index([role])
  @@index([orgId])
}

model Route {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id])
  stores      Store[]
  assignments RouteAssignment[]
  visits      Visit[]
  routeStores RouteStore[]
  attendances Attendance[]

  @@unique([orgId, name])
  @@index([orgId])
}

model RouteAssignment {
  id      String @id @default(cuid())
  orgId   String
  userId  String
  routeId String
  org     Organization @relation(fields: [orgId], references: [id])
  user    User   @relation(fields: [userId], references: [id])
  route   Route  @relation(fields: [routeId], references: [id])

  @@unique([userId, routeId])
  @@index([orgId])
}

model Store {
  id           String   @id @default(cuid())
  orgId        String
  externalCode String?
  name         String
  address      String
  phone        String?
  // Primary route, set by store-master import. A store can additionally be
  // assigned to other routes via RouteStore (e.g. two salesmen covering
  // different product lines both visit the same medical store).
  routeId      String?
  route        Route?   @relation(fields: [routeId], references: [id])
  visitSequence Int?
  // Set from the GPS captured on the first confirmed visit, so any salesman
  // covering this route later can see the store has already been located.
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())

  org              Organization @relation(fields: [orgId], references: [id])
  visits           Visit[]
  telecallerLogs   TelecallerLog[]
  ledgerEntries    LedgerEntry[]
  purchaseHistory  PurchaseHistoryItem[]
  routeStores      RouteStore[]
  telecallerParty  TelecallerParty?

  @@unique([orgId, externalCode])
  @@index([routeId])
  @@index([name])
  @@index([orgId])
}

model RouteStore {
  id            String   @id @default(cuid())
  orgId         String
  routeId       String
  storeId       String
  visitSequence Int?
  createdAt     DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  route Route @relation(fields: [routeId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([routeId, storeId])
  @@index([routeId])
  @@index([storeId])
  @@index([orgId])
}

model Visit {
  id               String         @id @default(cuid())
  orgId            String
  userId           String
  storeId          String
  routeId          String?
  visitDate        DateTime       @default(now())
  latitude         Float
  longitude        Float
  photoUrl         String
  collectionAmount Decimal?
  orderAmount      Decimal?
  hasOrder         Boolean        @default(false)
  hasDiscount      Boolean        @default(false)
  noOrderReason    NoOrderReason?
  notes            String?
  createdAt        DateTime       @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])
  route Route? @relation(fields: [routeId], references: [id])

  @@index([userId, visitDate])
  @@index([storeId])
  @@index([routeId])
  @@index([orgId])
}

model Attendance {
  id        String           @id @default(cuid())
  orgId     String
  userId    String
  date      DateTime
  status    AttendanceStatus
  note      String?
  // Set when status=ON_ROUTE — which of the salesman's assigned routes
  // they're declaring themselves out on today.
  routeId   String?
  // Optional colleague they're working with that day — filled via the
  // monthly Tour Plan grid, not the daily attendance buttons.
  workingWithUserId String?
  createdAt DateTime         @default(now())

  org        Organization @relation(fields: [orgId], references: [id])
  user       User   @relation(fields: [userId], references: [id])
  route      Route? @relation(fields: [routeId], references: [id])
  workingWith User?  @relation("AttendanceWorkingWith", fields: [workingWithUserId], references: [id])

  @@unique([userId, date])
  @@index([date])
  @@index([orgId])
}

model TelecallerLog {
  id               String         @id @default(cuid())
  orgId            String
  userId           String
  storeId          String
  contactDate      DateTime       @default(now())
  orderAmount      Decimal?
  // Free text (e.g. "promised 3000 on next visit") — shown to the salesman
  // as a note next time they visit this store.
  paymentPromise   String?
  collectionAmount Decimal?
  hasOrder         Boolean        @default(false)
  noOrderReason    NoOrderReason?
  noPaymentReason  String?
  complaintNotes   String?
  createdAt        DateTime       @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([userId, contactDate])
  @@index([storeId])
  @@index([orgId])
}

// Admin-defined recurring task (e.g. "sweep loading bay" every Monday, or
// "count fast-movers" on the 1st of the month). Not assigned to a specific
// person — any warehouse staff on shift can complete it.
model WarehouseTask {
  id          String         @id @default(cuid())
  orgId       String
  title       String
  description String?
  recurrence  TaskRecurrence
  dayOfWeek   Int? // 0=Sunday..6=Saturday, used when recurrence=WEEKLY
  dayOfMonth  Int? // 1-31, used when recurrence=MONTHLY
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())

  org         Organization @relation(fields: [orgId], references: [id])
  occurrences WarehouseTaskOccurrence[]

  @@index([orgId])
}

// One row per time a task actually comes due. scheduledDate starts equal to
// originalDate but rolls forward a day at a time — automatically, whenever
// the warehouse dashboard is loaded — for as long as it stays incomplete or
// the day it was due had no one marked present.
model WarehouseTaskOccurrence {
  id            String    @id @default(cuid())
  orgId         String
  taskId        String
  originalDate  DateTime
  scheduledDate DateTime
  completed     Boolean   @default(false)
  completedAt   DateTime?
  completedById String?

  org  Organization @relation(fields: [orgId], references: [id])
  task WarehouseTask @relation(fields: [taskId], references: [id])

  @@unique([taskId, originalDate])
  @@index([scheduledDate])
  @@index([orgId])
}

// The shelf-stock sheet: one physical count per item per day, regardless of
// which warehouse staff member recorded it.
model StockItem {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  company   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id])
  counts StockCount[]

  @@unique([orgId, name])
  @@index([company])
  @@index([orgId])
}

model StockCount {
  id            String   @id @default(cuid())
  orgId         String
  stockItemId   String
  date          DateTime
  quantity      Decimal
  recordedById  String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id])
  stockItem  StockItem @relation(fields: [stockItemId], references: [id])
  recordedBy User      @relation(fields: [recordedById], references: [id])

  @@unique([stockItemId, date])
  @@index([date])
  @@index([orgId])
}

model LedgerEntry {
  id                String    @id @default(cuid())
  orgId             String
  storeId           String
  invoiceNo         String?
  invoiceDate       DateTime?
  amount            Decimal
  outstandingAmount Decimal
  dueDate           DateTime?
  uploadBatchId     String
  importedAt        DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([uploadBatchId])
  @@index([orgId])
}

model PurchaseHistoryItem {
  id            String    @id @default(cuid())
  orgId         String
  storeId       String
  itemName      String
  quantity      Decimal
  unit          String?
  // Total sale value for this item over the report period — used to rank
  // "regularly bought items" highest-value-first for telecaller upsell asks.
  totalValue    Decimal?
  periodStart   DateTime?
  periodEnd     DateTime?
  uploadBatchId String
  importedAt    DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([itemName])
  @@index([orgId])
}

// Admin-updated incentive scheme: item + incentive amount, shown to
// salesmen as "current incentives" on their dashboard. Each upload
// replaces the whole list, same as ExpiryItem.
model IncentiveItem {
  id              String    @id @default(cuid())
  orgId           String
  itemName        String
  incentiveAmount Decimal
  uploadBatchId   String
  importedAt      DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model ExpiryItem {
  id            String    @id @default(cuid())
  orgId         String
  itemName      String
  expiryDate    DateTime
  specialRate   Decimal?
  uploadBatchId String
  importedAt    DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([expiryDate])
  @@index([orgId])
}

model Target {
  id                String   @id @default(cuid())
  orgId             String
  userId            String
  periodMonth       Int
  periodYear        Int
  monthlyTarget     Decimal
  todayTarget       Decimal
  perRetailerTarget Decimal
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, periodMonth, periodYear])
  @@index([orgId])
}

// Admin-uploaded call list ("party list"). If empty, the telecaller
// dashboard falls back to showing every store, so nothing breaks before
// the first upload.
model TelecallerParty {
  id            String   @id @default(cuid())
  orgId         String
  storeId       String
  uploadBatchId String
  importedAt    DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId])
  @@index([orgId])
}

model ImportBatch {
  id           String   @id @default(cuid())
  orgId        String
  importType   String
  fileName     String
  rowCount     Int
  uploadedById String
  createdAt    DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id])
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([orgId])
}
