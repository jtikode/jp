// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SALESMAN
  TELECALLER
  WAREHOUSE
  ADMIN
}

enum TaskRecurrence {
  DAILY
  WEEKLY
  MONTHLY
  ONCE
}

enum TaskStatus {
  PENDING
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  LEAVE
  HALF_LEAVE
  ABSENT
  HOLIDAY_WEEKOFF
  OFFICE_DAY
  ON_ROUTE
}

enum NoOrderReason {
  STORE_CLOSED
  NO_STOCK_NEEDED
  OWNER_NOT_AVAILABLE
  PAYMENT_DISPUTE
  COMPETITOR_STOCKED
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum BannerPlacement {
  HERO
  OFFER
}

// One row per business using the app. Every other model is scoped to one of
// these via orgId, so no query ever needs to reason about more than one
// business's data at a time. `slug` is the "Business Code" typed at login
// and signup — there is no subdomain/custom-domain routing.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  // Fixed UPI ID used to build the retailer shop's "Pay Online" deep link +
  // QR code — no payment gateway, just opens the retailer's own UPI app.
  upiVpa       String?
  upiPayeeName String?

  users            User[]
  routes           Route[]
  routeAssignments RouteAssignment[]
  stores           Store[]
  routeStores      RouteStore[]
  visits           Visit[]
  attendances      Attendance[]
  telecallerLogs   TelecallerLog[]
  telecallerCallSchedules TelecallerCallSchedule[]
  tasks            Task[]
  taskOccurrences  TaskOccurrence[]
  stockItems       StockItem[]
  stockCounts      StockCount[]
  ledgerEntries    LedgerEntry[]
  purchaseHistory  PurchaseHistoryItem[]
  incentiveItems   IncentiveItem[]
  expiryItems      ExpiryItem[]
  targets          Target[]
  telecallerParties TelecallerParty[]
  importBatches    ImportBatch[]
  products         Product[]
  wednesdayDeals   WednesdayDeal[]
  orders           Order[]
  orderItems       OrderItem[]
  banners          ShopBanner[]
  loyaltyTiers     LoyaltyTier[]
  requestedProducts RequestedProduct[]
  pushSubscriptions PushSubscription[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  username     String
  passwordHash String
  name         String
  role         Role
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  org              Organization      @relation(fields: [orgId], references: [id])
  routeAssignments RouteAssignment[]
  visits           Visit[]
  attendances      Attendance[]
  telecallerLogs   TelecallerLog[]
  stockCounts      StockCount[]
  targets          Target[]
  importBatches    ImportBatch[]
  workingWithAttendances Attendance[] @relation("AttendanceWorkingWith")
  assignedTasks    Task[]

  @@unique([orgId, username])
  @@index([role])
  @@index([orgId])
}

model Route {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  createdAt   DateTime @default(now())

  org           Organization @relation(fields: [orgId], references: [id])
  stores        Store[]
  assignments   RouteAssignment[]
  visits        Visit[]
  routeStores   RouteStore[]
  attendances   Attendance[]
  callSchedule  TelecallerCallSchedule?

  @@unique([orgId, name])
  @@index([orgId])
}

// Which day of the week a telecaller calls a given route on — a simple
// recurring weekly pattern (not date-specific), self-managed by the
// telecaller from their own Calendar page.
model TelecallerCallSchedule {
  id        String @id @default(cuid())
  orgId     String
  routeId   String @unique
  dayOfWeek Int // 0=Sunday..6=Saturday

  org   Organization @relation(fields: [orgId], references: [id])
  route Route @relation(fields: [routeId], references: [id])

  @@index([orgId])
  @@index([dayOfWeek])
}

model RouteAssignment {
  id      String @id @default(cuid())
  orgId   String
  userId  String
  routeId String
  org     Organization @relation(fields: [orgId], references: [id])
  user    User   @relation(fields: [userId], references: [id])
  route   Route  @relation(fields: [routeId], references: [id])

  @@unique([userId, routeId])
  @@index([orgId])
}

model Store {
  id           String   @id @default(cuid())
  orgId        String
  externalCode String?
  name         String
  address      String
  phone        String?
  // Name of whoever the phone number actually reaches (owner/manager) — kept
  // separate from `phone` so a telecaller can record who they're calling,
  // not just the number.
  contactPersonName String?
  // Primary route, set by store-master import. A store can additionally be
  // assigned to other routes via RouteStore (e.g. two salesmen covering
  // different product lines both visit the same medical store).
  routeId      String?
  route        Route?   @relation(fields: [routeId], references: [id])
  visitSequence Int?
  // Set from the GPS captured on the first confirmed visit, so any salesman
  // covering this route later can see the store has already been located.
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())
  // 4-digit shop login code, admin-issued in bulk (see generateShopLoginCredentials)
  // instead of requiring retailer self-registration — works even for the many
  // stores with no phone on file. The shop login password is always this
  // code's digits reversed, so no separate plaintext password needs storing.
  loginCode    String?
  // Set once the retailer has shop access — either via bulk-issued loginCode
  // or (legacy) self-activation with Business Code + phone + PIN. Null means
  // they haven't yet.
  pinHash      String?
  // Updated on every successful shop activation/login, so admin can see
  // which retailers are actually using the app vs. never activated/gone quiet.
  lastLoginAt  DateTime?
  // Captured once, on the retailer's first shop login — the personal WhatsApp
  // number of whoever is actually placing orders (not necessarily the shop's
  // own registered `phone`), since one shared login can be used by different
  // staff at the store. Null means we haven't asked yet.
  orderGiverWhatsapp String?

  org              Organization @relation(fields: [orgId], references: [id])
  visits           Visit[]
  telecallerLogs   TelecallerLog[]
  ledgerEntries    LedgerEntry[]
  purchaseHistory  PurchaseHistoryItem[]
  routeStores      RouteStore[]
  telecallerParty  TelecallerParty?
  orders           Order[]
  requestedProducts RequestedProduct[]
  pushSubscriptions PushSubscription[]

  @@unique([orgId, externalCode])
  @@unique([orgId, loginCode])
  @@index([routeId])
  @@index([name])
  @@index([orgId])
}

model RouteStore {
  id            String   @id @default(cuid())
  orgId         String
  routeId       String
  storeId       String
  visitSequence Int?
  createdAt     DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  route Route @relation(fields: [routeId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([routeId, storeId])
  @@index([routeId])
  @@index([storeId])
  @@index([orgId])
}

model Visit {
  id               String         @id @default(cuid())
  orgId            String
  userId           String
  storeId          String
  routeId          String?
  visitDate        DateTime       @default(now())
  latitude         Float
  longitude        Float
  photoUrl         String
  collectionAmount Decimal?
  orderAmount      Decimal?
  hasOrder         Boolean        @default(false)
  hasDiscount      Boolean        @default(false)
  noOrderReason    NoOrderReason?
  notes            String?
  createdAt        DateTime       @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])
  route Route? @relation(fields: [routeId], references: [id])

  @@index([userId, visitDate])
  @@index([storeId])
  @@index([routeId])
  @@index([orgId])
}

model Attendance {
  id        String           @id @default(cuid())
  orgId     String
  userId    String
  date      DateTime
  status    AttendanceStatus
  note      String?
  // Set when status=ON_ROUTE — which of the salesman's assigned routes
  // they're declaring themselves out on today.
  routeId   String?
  // Optional colleague they're working with that day — filled via the
  // monthly Tour Plan grid, not the daily attendance buttons.
  workingWithUserId String?
  createdAt DateTime         @default(now())

  org        Organization @relation(fields: [orgId], references: [id])
  user       User   @relation(fields: [userId], references: [id])
  route      Route? @relation(fields: [routeId], references: [id])
  workingWith User?  @relation("AttendanceWorkingWith", fields: [workingWithUserId], references: [id])

  @@unique([userId, date])
  @@index([date])
  @@index([orgId])
}

model TelecallerLog {
  id               String         @id @default(cuid())
  orgId            String
  userId           String
  storeId          String
  contactDate      DateTime       @default(now())
  orderAmount      Decimal?
  // Free text (e.g. "promised 3000 on next visit") — shown to the salesman
  // as a note next time they visit this store.
  paymentPromise   String?
  collectionAmount Decimal?
  hasOrder         Boolean        @default(false)
  noOrderReason    NoOrderReason?
  noPaymentReason  String?
  complaintNotes   String?
  createdAt        DateTime       @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([userId, contactDate])
  @@index([storeId])
  @@index([orgId])
}

// Admin-defined task, daily/weekly/monthly/one-time, for any employee across
// any role. assignedToId targets one specific person; when it's null the
// task is scoped to assignedRole instead (e.g. every WAREHOUSE staffer sees
// it) — this is what preserves the original "any warehouse staff on shift
// can complete it" behavior for tasks nobody assigned to a named person.
model Task {
  id            String         @id @default(cuid())
  orgId         String
  title         String
  description   String?
  recurrence    TaskRecurrence
  // Optional "HH:mm" — display/ordering hint only, not enforced.
  scheduledTime String?
  dayOfWeek     Int? // 0=Sunday..6=Saturday, used when recurrence=WEEKLY
  dayOfMonth    Int? // 1-31, used when recurrence=MONTHLY
  assignedToId  String?
  assignedRole  Role?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  org         Organization @relation(fields: [orgId], references: [id])
  assignedTo  User?        @relation(fields: [assignedToId], references: [id])
  occurrences TaskOccurrence[]

  @@index([orgId])
  @@index([assignedToId])
}

// One row per time a task actually comes due. Tied to its own due date —
// unlike the old warehouse-only version, a missed occurrence does NOT roll
// forward to the next day; it just stays PENDING against its original date,
// which is what makes a missed day read as blank in the completion chart
// instead of silently reappearing later.
model TaskOccurrence {
  id            String     @id @default(cuid())
  orgId         String
  taskId        String
  originalDate  DateTime
  scheduledDate DateTime
  status        TaskStatus @default(PENDING)
  completedAt   DateTime?
  completedById String?
  approvedAt    DateTime?
  approvedById  String?

  org  Organization @relation(fields: [orgId], references: [id])
  task Task @relation(fields: [taskId], references: [id])

  @@unique([taskId, originalDate])
  @@index([scheduledDate])
  @@index([orgId])
}

// The shelf-stock sheet: one physical count per item per day, regardless of
// which warehouse staff member recorded it.
model StockItem {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  company   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  org    Organization @relation(fields: [orgId], references: [id])
  counts StockCount[]

  @@unique([orgId, name])
  @@index([company])
  @@index([orgId])
}

model StockCount {
  id            String   @id @default(cuid())
  orgId         String
  stockItemId   String
  date          DateTime
  quantity      Decimal
  recordedById  String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id])
  stockItem  StockItem @relation(fields: [stockItemId], references: [id])
  recordedBy User      @relation(fields: [recordedById], references: [id])

  @@unique([stockItemId, date])
  @@index([date])
  @@index([orgId])
}

model LedgerEntry {
  id                String    @id @default(cuid())
  orgId             String
  storeId           String
  invoiceNo         String?
  invoiceDate       DateTime?
  amount            Decimal
  outstandingAmount Decimal
  dueDate           DateTime?
  uploadBatchId     String
  importedAt        DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([uploadBatchId])
  @@index([orgId])
}

model PurchaseHistoryItem {
  id            String    @id @default(cuid())
  orgId         String
  storeId       String
  itemName      String
  quantity      Decimal
  unit          String?
  // Total sale value for this item over the report period — used to rank
  // "regularly bought items" highest-value-first for telecaller upsell asks.
  totalValue    Decimal?
  periodStart   DateTime?
  periodEnd     DateTime?
  uploadBatchId String
  importedAt    DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@index([storeId])
  @@index([itemName])
  @@index([orgId])
}

// Admin-updated incentive scheme: item + incentive amount, shown to
// salesmen as "current incentives" on their dashboard. Each upload
// replaces the whole list, same as ExpiryItem.
model IncentiveItem {
  id              String    @id @default(cuid())
  orgId           String
  itemName        String
  incentiveAmount Decimal
  uploadBatchId   String
  importedAt      DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

model ExpiryItem {
  id            String    @id @default(cuid())
  orgId         String
  itemName      String
  expiryDate    DateTime
  specialRate   Decimal?
  uploadBatchId String
  importedAt    DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([expiryDate])
  @@index([orgId])
}

model Target {
  id                String   @id @default(cuid())
  orgId             String
  userId            String
  periodMonth       Int
  periodYear        Int
  monthlyTarget     Decimal
  todayTarget       Decimal
  perRetailerTarget Decimal
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, periodMonth, periodYear])
  @@index([orgId])
}

// Admin-uploaded call list ("party list"). If empty, the telecaller
// dashboard falls back to showing every store, so nothing breaks before
// the first upload.
model TelecallerParty {
  id            String   @id @default(cuid())
  orgId         String
  storeId       String
  uploadBatchId String
  importedAt    DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([storeId])
  @@index([orgId])
}

model ImportBatch {
  id           String   @id @default(cuid())
  orgId        String
  importType   String
  fileName     String
  rowCount     Int
  uploadedById String
  createdAt    DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id])
  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([orgId])
}

// Sellable catalog item shown to retailers in the self-order shop. Separate
// from StockItem (the warehouse's internal daily count-sheet dimension) —
// this one carries a price and is customer-facing.
model Product {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  company     String?
  unit        String?
  price       Decimal
  // Reference/pre-discount price shown struck through next to the selling
  // price, and the applicable GST-style tax rate, both purely informational.
  mrp         Decimal?
  taxPercent  Decimal?
  scheme      String?
  // Salt/molecule composition (e.g. "AMOXYCILLIN+POTASSIUM CLAVULANATE") —
  // lets a retailer or telecaller find/verify a product by its salt, not
  // just its brand name.
  composition String?
  // Admin-uploaded shelf quantity. Retailers see the exact number once it's
  // 3 or more; below that, the shop shows a plain "Low Stock" warning
  // instead of the number itself. Null means stock hasn't been set yet.
  stock       Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  org            Organization @relation(fields: [orgId], references: [id])
  orderItems     OrderItem[]
  wednesdayDeal  WednesdayDeal?

  @@unique([orgId, name])
  @@index([orgId])
}

// Admin-defined weekly deal: this product sells at dealPrice, capped at
// maxQtyPerStore per retailer, every Wednesday — a recurring config, not a
// one-off dated banner, so one row per product covers "the current deal".
model WednesdayDeal {
  id             String   @id @default(cuid())
  orgId          String
  productId      String   @unique
  dealPrice      Decimal
  maxQtyPerStore Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  org        Organization @relation(fields: [orgId], references: [id])
  product    Product      @relation(fields: [productId], references: [id])
  orderItems OrderItem[]

  @@index([orgId])
}

// A retailer-placed order from the self-order shop. Payment/collection still
// happens offline (cash/credit) exactly as it does today — this only tracks
// what was ordered and its fulfillment status.
model Order {
  id          String      @id @default(cuid())
  orgId       String
  storeId     String
  status      OrderStatus @default(PENDING)
  totalAmount Decimal
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  org   Organization @relation(fields: [orgId], references: [id])
  store Store        @relation(fields: [storeId], references: [id])
  items OrderItem[]

  @@index([orgId])
  @@index([storeId])
}

// productName/unitPrice are snapshots at order time, not live joins to
// Product — matches LedgerEntry/ImportBatch elsewhere in this schema, so a
// past order stays accurate even if the product is later renamed, repriced,
// or deactivated.
model OrderItem {
  id          String  @id @default(cuid())
  orgId       String
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal
  quantity    Int
  lineTotal   Decimal
  // Set when this line was bought at a Wednesday Deal price — lets placeOrder
  // sum up how much of a deal's max-qty-per-store cap a retailer has already
  // used today.
  dealId      String?

  org     Organization   @relation(fields: [orgId], references: [id])
  order   Order          @relation(fields: [orderId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  deal    WednesdayDeal? @relation(fields: [dealId], references: [id])

  @@index([orgId])
  @@index([orderId])
  @@index([dealId])
}

// Promotional image shown on the retailer shop's home dashboard — HERO for
// the top carousel, OFFER for the "Special Offers" carousel below the menu
// grid. One model covers both via `placement` rather than two near-identical
// models.
model ShopBanner {
  id        String          @id @default(cuid())
  orgId     String
  placement BannerPlacement
  imageUrl  String
  title     String?
  linkUrl   String?
  sortOrder Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  // Set only for a time-boxed "flash deal" — retailers get a push
  // notification when one is created, and the banner stops showing once
  // this passes. Null means an ordinary, non-expiring banner.
  expiresAt DateTime?

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// Admin-configured reward tiers shown on the retailer shop's home dashboard
// (e.g. "spend ₹4L this year, get a trolley bag"), with the retailer's own
// progress toward the next one computed live from their order history.
model LoyaltyTier {
  id              String   @id @default(cuid())
  orgId           String
  thresholdAmount Decimal
  rewardText      String
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// A retailer asking for a product that isn't in the catalog yet. Reviewed
// manually by admin — no notification wiring, just a list to check.
model RequestedProduct {
  id          String   @id @default(cuid())
  orgId       String
  storeId     String
  productName String
  note        String?
  reviewed    Boolean  @default(false)
  createdAt   DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  store Store        @relation(fields: [storeId], references: [id])

  @@index([orgId])
  @@index([storeId])
}

// A retailer's browser Push API subscription, used to send order-status
// updates. `endpoint` is unique per browser install (not per store), so a
// retailer opting in on two devices gets two rows and a push on both.
model PushSubscription {
  id        String   @id @default(cuid())
  orgId     String
  storeId   String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  store Store        @relation(fields: [storeId], references: [id])

  @@index([orgId])
  @@index([storeId])
}
